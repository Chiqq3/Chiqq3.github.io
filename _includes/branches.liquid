<div class="branches">
  <h2 class="branches-heading">{{ page.branches_title | default: "Branches" }}</h2>
  <div class="row row-cols-1 row-cols-md-2">
    {% for branch in page.branches %}
      <div class="col mb-4">
        <a
          href="{% if branch.external %}{{ branch.url }}{% else %}{{ branch.url | relative_url }}{% endif %}"
          {% if branch.external %}target="_blank" rel="noopener"{% endif %}
        >
          <div class="card h-100 hoverable branch-card">
            <div class="card-body">
              <div class="branch-marker"><i class="fa-solid fa-code-branch"></i></div>
              <h3 class="card-title">{{ branch.title }}</h3>
              {% if branch.date %}
                <p class="branch-date">{{ branch.date | date: "%b %-d, %Y" }}</p>
              {% endif %}
              <p class="card-text">{{ branch.description }}</p>
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>
